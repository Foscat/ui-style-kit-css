        "producerScope": "[data-ui][data-mode]",
        "standaloneExpectation": "available-with-ui-style-kit-entrypoints"
      },
      {
        "name": "--ui-radius-control",
        "type": "<length>",
        "namespacedSource": "var(--usk-native-radius)",
        "producerScope": "[data-ui][data-mode]",
        "standaloneExpectation": "available-with-ui-style-kit-entrypoints"
      },
      {
        "name": "--ui-shadow-control",
