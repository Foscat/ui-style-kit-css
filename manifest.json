{
  "schemaVersion": 1,
  "schemaPolicy": {
    "compatibility": "additive-within-major",
    "breakingChange": "increment-schemaVersion-before-removing-or-renaming-fields"
  },
  "name": "ui-style-kit-css",
  "version": "2.1.0",
  "cascadeLayers": [
    "ui-style-kit.theme_colors",
    "ui-style-kit.native_elements",
    "ui-style-kit.components",
    "ui-style-kit.presets",
    "ui-style-kit.compat_layout"
  ],
  "presets": [
    {
      "id": "minimal-saas",
      "label": "Minimal SaaS",
      "prefix": "saas",
      "entrypoints": {
        "default": "./minimal-saas.css",
        "visual": "./visual/minimal-saas.css"
      }
    },
    {
      "id": "bento",
      "label": "Bento UI",
      "prefix": "bento",
      "entrypoints": {
        "default": "./bento.css",
        "visual": "./visual/bento.css"
      }
    },
    {
      "id": "maximalist",
      "label": "Maximalist / Playful",
      "prefix": "max",
      "entrypoints": {
        "default": "./maximalist.css",
        "visual": "./visual/maximalist.css"
      }
    },
    {
      "id": "bauhaus",
      "label": "Bauhaus / Swiss Modern",
      "prefix": "bau",
      "entrypoints": {
        "default": "./bauhaus.css",
        "visual": "./visual/bauhaus.css"
      }
    },
    {
      "id": "tactile",
      "label": "Skeuomorphic / Tactile",
      "prefix": "tactile",
      "entrypoints": {
        "default": "./tactile.css",
        "visual": "./visual/tactile.css"
      }
    },
    {
      "id": "neumorphism",
      "label": "Neumorphism",
      "prefix": "neo",
      "entrypoints": {
        "default": "./neumorphism.css",
        "visual": "./visual/neumorphism.css"
      }
    },
    {
      "id": "retrofuturism",
      "label": "Retrofuturism",
      "prefix": "retro",
      "entrypoints": {
        "default": "./retrofuturism.css",
        "visual": "./visual/retrofuturism.css"
      }
    },
    {
      "id": "brutalism",
      "label": "Brutalism",
      "prefix": "brutal",
      "entrypoints": {
        "default": "./brutalism.css",
        "visual": "./visual/brutalism.css"
      }
    },
    {
      "id": "cyberpunk",
      "label": "Cyberpunk",
      "prefix": "cyber",
      "entrypoints": {
        "default": "./cyberpunk.css",
        "visual": "./visual/cyberpunk.css"
      }
    },
    {
      "id": "y2k",
      "label": "Y2K",
      "prefix": "y2k",
      "entrypoints": {
        "default": "./y2k.css",
        "visual": "./visual/y2k.css"
      }
    },
    {
      "id": "retro-glass",
      "label": "Retro Glass",
      "prefix": "rg",
      "entrypoints": {
        "default": "./retro-glass.css",
        "visual": "./visual/retro-glass.css"
      }
    }
  ],
