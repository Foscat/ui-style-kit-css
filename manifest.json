        "name": "--ui-color-bg",
        "type": "<color>",
        "namespacedSource": "var(--usk-native-bg)",
        "producerScope": "[data-ui][data-mode]",
        "standaloneExpectation": "available-with-ui-style-kit-entrypoints"
      },
      {
        "name": "--ui-color-surface",
        "type": "<color>",
        "namespacedSource": "var(--usk-native-surface-strong)",
        "producerScope": "[data-ui][data-mode]",
